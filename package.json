{
  "name": "amp-vending-website",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "pre-commit": "npm run type-check && npm run lint",
    "pre-push": "npm run test:all",
    "validate": "npm run type-check && npm run build",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "type-check": "tsc --noEmit --skipLibCheck",
    "test": "jest",
    "test:unit": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --watchAll=false",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "test:ci:no-coverage": "jest --ci --watchAll=false --passWithNoTests --maxWorkers=2",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:a11y": "tsx scripts/test-accessibility.ts",
    "test:all": "npm run type-check && npm run test:coverage && npm run test:e2e",
    "test:all:coverage": "npm run type-check && npm run test:ci && npm run test:e2e",
    "test:setup": "playwright install",
    "test:setup:deps": "playwright install-deps",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "catalog:pdf": "node scripts/generate-catalog-pdf.mjs",
    "clean": "node -e \"for (const d of ['.next','coverage','test-results','playwright-report']) require('fs').rmSync(d, { recursive: true, force: true })\"",
    "lighthouse": "tsx ./scripts/lighthouse-test.ts",
    "performance": "npm run lighthouse",
    "accessibility": "npm run test:e2e -- --grep @accessibility",
    "lint:check": "eslint . --ext .js,.jsx,.ts,.tsx --max-warnings 0",
    "index:request": "tsx scripts/request-indexing.ts"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@hookform/resolvers": "^5.2.2",
    "@microsoft/clarity": "^1.0.2",
    "@next/third-parties": "^16.1.6",
    "@supabase/supabase-js": "^2.55.0",
    "@vercel/analytics": "^1.4.1",
    "@vercel/speed-insights": "^1.1.0",
    "bcryptjs": "^3.0.2",
    "clsx": "^2.1.1",
    "framer-motion": "^11.15.0",
    "google-auth-library": "^10.2.1",
    "googleapis": "^167.0.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.468.0",
    "next": "^16.3.1",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-hook-form": "^7.71.1",
    "react-intersection-observer": "^9.16.0",
    "resend": "^4.0.1",
    "sonner": "^1.7.1",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "web-vitals": "^3.5.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@eslint/eslintrc": "^3.3.4",
    "@playwright/test": "^1.56.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.6",
    "@types/react": "^19.0.6",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "critters": "^0.0.23",
    "eslint": "^9.39.2",
    "eslint-config-next": "^15.1.5",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.4.1",
    "playwright": "^1.57.0",
    "postcss": "^8.4.49",
    "prettier": "^3.0.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.22.4",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "@testing-library/react": {
      "react": "$react",
      "react-dom": "$react-dom"
    }
  }
}
